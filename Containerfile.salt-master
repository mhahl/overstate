# Salt master: stock image plus the postgres driver the pgjsonb /
# postgres_local_cache returners need (multi-master shared job cache), and
# redis-py for the shared Redis minion-data cache.
# Used in local dev and production alike.
# Pin :lts by digest so a retag cannot silently skip
# salt-cluster-identity-patch.py anchors.
FROM ghcr.io/cdalvaro/docker-salt-master:lts@sha256:df5bb4555108f21655f97f5be11f5404a5596bd475cb8181ab2c88bd91adb12c

RUN /opt/saltstack/salt/bin/pip install --no-cache-dir \
    "psycopg2-binary==2.9.13" \
    "redis==6.4.0" \
    "pynacl==1.6.2"

# Cluster identity is the stable pod DNS name (<POD_NAME>.<headless
# service>), not the pod IP: upstream salt keys Raft membership, the
# join sentinel, founder election, and ring ownership on `interface`,
# so pod recreates orphan membership (dead voters, lost quorum,
# cluster_retry on all traffic). The patcher redirects those sites to
# the `cluster_node_id` opt the entrypoint stamps; it fails the build
# loudly if its anchors drift (base-image salt upgrade). The base
# regenerates /etc/salt/master at boot, so the wrapper writes
# interface/id/cluster_node_id/peers to a PVC drop-in included from
# the ConfigMap before handing over.
COPY cluster-entrypoint.sh /usr/local/bin/cluster-entrypoint.sh
# Custom master job-cache returner (docs/reference/returner.md): stock
# pgjsonb bare-INSERTs every return, so in a 3-master cluster sharing one
# Postgres table the two members that receive a return via bus
# replication crash into the (jid, id) PK on every job. The upsert
# variant absorbs those duplicates with ON CONFLICT DO NOTHING.
# extension_modules is baked to /var/cache/salt/master/extmods (NOT on
# any PVC and NOT under file_roots), so the module must ship in the
# image — masters cannot pick it up from the srv share. Shipped inert:
# activation is the `master_job_cache: pgjsonb_upsert` flip plus a
# master restart, deliberately not yet applied.
COPY salt-extmods/pgjsonb_upsert.py /var/cache/salt/master/extmods/pgjsonb_upsert.py
# Sibling helper: API-backed peer discovery for the entrypoint's
# self-healing (EndpointSlices with constructed-name fallback), stdlib only.
COPY cluster-peers.py /usr/local/bin/cluster-peers.py
COPY cluster-ready.py /usr/local/bin/cluster-ready.py
# Build-time Salt patches: stable DNS node identities and per-master
# localfs Raft storage (independent of the global minion-data cache).
# Resolve the installed tree rather than hardcoding a Python path, and
# abort the build on any upstream anchor mismatch.
COPY salt-cluster-identity-patch.py /usr/local/bin/salt-cluster-identity-patch.py
RUN SALT_PY="$(ls /opt/saltstack/salt/bin/python3* | grep -v -e config -e -dbg | head -1)" \
    && "$SALT_PY" /usr/local/bin/salt-cluster-identity-patch.py \
    "$("$SALT_PY" -c 'import os, salt; print(os.path.dirname(os.path.dirname(salt.__file__)))')"
# N.B. setting ENTRYPOINT clears the base CMD, so restate it — without
# args the base falls through to `exec "$@"` with nothing and the
# container exits 0 immediately.
ENTRYPOINT ["/usr/local/bin/cluster-entrypoint.sh"]
CMD ["app:start"]

# The built-in dev minion reports these mine functions so the Mine
# browser has real data (plus whatever mine.send publishes). The
# image reads minion drop-ins from /home/salt/data/minion_config,
# not /etc/salt/minion.d.
RUN mkdir -p /home/salt/data/minion_config \
    && printf 'mine_functions:\n  network.ip_addrs: []\n  test.ping: []\nmine_interval: 5\n' \
        > /home/salt/data/minion_config/mine.conf
