SALT_API_URL=http://salt-master:8000
SALT_EAUTH_USER=overstate
SALT_EAUTH_PASSWORD=dev-salt-api-pass
SECRET_KEY=change-me-in-production
# RQ pickles job payloads, so Redis requires a password: compose passes
# it to redis-server and to the app/worker via REDIS_URL below.
# Production (Kubernetes) takes these from the owner-held Secrets instead.
REDIS_PASSWORD=dev-redis-pass
REDIS_URL=redis://:dev-redis-pass@redis:6379/0
# SSO (optional fallback; prefer the server Settings page, see docs/sso.md).
# Unset everywhere means local login only. The secret may also live in
# the Settings page; the variable below applies when it does not.
#OIDC_ISSUER=https://login.example.com/realms/ops
#OIDC_CLIENT_ID=overstate
#OIDC_CLIENT_SECRET=change-me-in-production
#OIDC_GROUPS_CLAIM=groups
#OIDC_ADMIN_GROUPS=overstate-admins
#OIDC_OPERATOR_GROUPS=overstate-operators
