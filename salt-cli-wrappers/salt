#!/usr/bin/env python3
"""Salt CLI wrapper for salt-cli pod."""
import sys
import os
import json
import ssl
import urllib.request
import urllib.error

ROLE = os.environ.get("OVERSTATE_ROLE", "viewer").lower()
API_USER = os.environ.get("SALT_API_USER", "overstate")
API_PASS = os.environ.get("SALT_API_USER_PASS", "")
MASTERS = [
    "https://salt-master-0.salt-master.overstate.svc.cluster.local:8000",
    "https://salt-master-1.salt-master.overstate.svc.cluster.local:8000",
    "https://salt-master-2.salt-master.overstate.svc.cluster.local:8000",
    "https://salt-master-api.overstate.svc.cluster.local:8000",
]

def print_help():
    print("""Usage: salt [options] '<target>' <function> [arguments]

Options:
  -h, --help            show this help message and exit
  -t TGT_TYPE, --tgt-type=TGT_TYPE
                        The type of target expression: glob, grain, list, compound
  --preview             dry-run preview
""")

def format_yaml(val, indent=4):
    pad = " " * indent
    if isinstance(val, dict):
        if not val:
            return "{}"
        lines = []
        for k, v in val.items():
            if isinstance(v, (dict, list)):
                lines.append(f"{pad}{k}:")
                lines.append(format_yaml(v, indent + 2))
            else:
                lines.append(f"{pad}{k}: {v}")
        return "\n".join(lines)
    elif isinstance(val, list):
        if not val:
            return "[]"
        lines = []
        for item in val:
            if isinstance(item, (dict, list)):
                lines.append(f"{pad}-")
                lines.append(format_yaml(item, indent + 2))
            else:
                lines.append(f"{pad}- {item}")
        return "\n".join(lines)
    else:
        return f"{pad}{val}"

def main():
    args = sys.argv[1:]
    if not args or "-h" in args or "--help" in args:
        print_help()
        sys.exit(0)

    if ROLE == "viewer":
        print("forbidden: viewer role cannot fire salt commands.", file=sys.stderr)
        sys.exit(1)

    tgt_type = "glob"
    positional = []
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("-t", "--tgt-type"):
            i += 1
            if i < len(args):
                tgt_type = args[i]
        elif a.startswith("--tgt-type="):
            tgt_type = a.split("=", 1)[1]
        elif a.startswith("-"):
            pass
        else:
            positional.append(a)
        i += 1

    if len(positional) < 2:
        print("Usage: salt [options] '<target>' <function> [arguments]", file=sys.stderr)
        sys.exit(1)

    tgt = positional[0]
    fun = positional[1]
    arg_list = positional[2:]

    ctx = ssl._create_unverified_context()
    login_data = json.dumps({"username": API_USER, "password": API_PASS, "eauth": "pam"}).encode()
    call_payload = [{"client": "local", "tgt": tgt, "fun": fun, "arg": arg_list, "tgt_type": tgt_type}]
    call_data = json.dumps(call_payload).encode()

    all_returns = {}
    success = False
    # Per-endpoint outcomes: "ok", "denied" (HTTP 401 on the call —
    # function unknown or not in the overstate eauth grants),
    # "login-denied" (HTTP 401 on /login — bad API credentials), or
    # "down" (unreachable / other HTTP error). Lumping these together
    # produced "could not contact salt-master cluster" for a mere 401,
    # hiding a typo'd function behind a cluster-down scare.
    outcomes = []

    for master_url in MASTERS:
        try:
            req = urllib.request.Request(f"{master_url}/login", data=login_data, headers={"Content-Type": "application/json"})
            with urllib.request.urlopen(req, context=ctx, timeout=4) as r:
                token = json.loads(r.read())["return"][0]["token"]
        except urllib.error.HTTPError as exc:
            outcomes.append(("login-denied" if exc.code == 401 else "down", master_url))
            continue
        except Exception:
            outcomes.append(("down", master_url))
            continue

        try:
            req2 = urllib.request.Request(master_url, data=call_data, headers={"Content-Type": "application/json", "X-Auth-Token": token})
            with urllib.request.urlopen(req2, context=ctx, timeout=10) as r:
                res = json.loads(r.read())
                ret = res.get("return", [{}])[0]
                if isinstance(ret, dict):
                    all_returns.update(ret)
                success = True
                outcomes.append(("ok", master_url))
        except urllib.error.HTTPError as exc:
            outcomes.append(("denied" if exc.code == 401 else "down", master_url))
            continue
        except Exception:
            outcomes.append(("down", master_url))
            continue

    if not success and not all_returns:
        states = {state for state, _ in outcomes}
        if states <= {"down"}:
            print(f"Error: could not contact salt-master cluster", file=sys.stderr)
        elif "login-denied" in states and "denied" not in states:
            print(
                "Error: salt-api login rejected (HTTP 401) on every reachable "
                "master — check SALT_API_USER / SALT_API_USER_PASS.",
                file=sys.stderr,
            )
        else:
            down = sorted(url for state, url in outcomes if state == "down")
            print(
                f"Error: {fun} was refused (HTTP 401) on every reachable master. "
                "The function may not exist or the overstate user may not be "
                "granted it in api.conf (e.g. highstate.apply is not a function "
                "— use state.highstate / state.apply).",
                file=sys.stderr,
            )
            if down:
                print(f"Unreachable endpoints (not tried further): {', '.join(down)}", file=sys.stderr)
        sys.exit(1)

    if not all_returns:
        print(f"No minions responded to {fun}.")
        sys.exit(0)

    for minion, ret in sorted(all_returns.items()):
        print(f"{minion}:")
        if isinstance(ret, (dict, list)):
            print(format_yaml(ret, indent=4))
        else:
            print(f"    {ret}")

if __name__ == "__main__":
    main()
