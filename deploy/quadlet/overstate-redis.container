[Unit]
Description=Overstate Redis (RQ job queue)
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=redis
Image=docker.io/library/redis:7-alpine
Network=overstate.network
# RQ pickles job payloads, so the queue is authenticated (REDIS_PASSWORD
# comes from /etc/overstate/overstate.env, written by install.sh).
EnvironmentFile=/etc/overstate/overstate.env
Exec=redis-server --requirepass ${REDIS_PASSWORD}

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
