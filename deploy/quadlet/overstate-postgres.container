[Unit]
Description=Overstate PostgreSQL
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=postgres
Image=docker.io/library/postgres:16
Network=overstate.network
Volume=overstate-pgdata:/var/lib/postgresql/data:Z
Environment=POSTGRES_USER=overstate
Environment=POSTGRES_DB=overstate
EnvironmentFile=/etc/overstate/overstate.env

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
