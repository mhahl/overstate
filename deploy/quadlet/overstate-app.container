[Unit]
Description=Overstate UI (Salt control plane)
After=network-online.target overstate-postgres.service overstate-redis.service overstate-salt-master.service
Wants=network-online.target
Requires=overstate-postgres.service overstate-redis.service overstate-salt-master.service

[Container]
ContainerName=overstate-app
Image=localhost/overstate:latest
Network=overstate.network
EnvironmentFile=/etc/overstate/overstate.env
Volume=/etc/overstate/tls:/srv/tls:ro,z
Volume=/var/lib/overstate/srv:/srv/states:ro,z

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
