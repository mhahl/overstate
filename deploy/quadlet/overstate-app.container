[Unit]
Description=Overstate UI (Salt control plane)
After=network-online.target overstate-postgres.service overstate-redis.service overstate-salt-master.service
Wants=network-online.target
Requires=overstate-postgres.service overstate-redis.service overstate-salt-master.service

[Container]
ContainerName=overstate-app
Image=localhost/overstate:latest
Network=overstate.network
EnvironmentFile=/etc/overstate/overstate.env
# Behind Caddy the app trusts X-Forwarded-Host/Port/Proto for CSRF origin
# checks and url_for; never set this where clients reach gunicorn directly.
Environment=TRUST_PROXY=1
Volume=/etc/overstate/tls:/srv/tls:ro,z
# Writable: the Files page edits (operator commits), syncs
# (pull --ff-only), and pushes (admin) on this checkout (FILE_ROOTS in
# /etc/overstate/overstate.env points inside it). The salt-master
# copy stays read-only; the app is the only writer.
Volume=/var/lib/overstate/srv:/srv/states:rw,z
# SSH deploy key for push (see "Push credentials" in docs/deployment.md):
# private key + known_hosts, root-only on the host, read-only here.
Volume=/etc/overstate/ssh:/srv/ssh:ro,z

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
